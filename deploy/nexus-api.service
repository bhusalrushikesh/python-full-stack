[Unit]
Description=Nexus Inventory FastAPI
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/nexus/backend
EnvironmentFile=/var/www/nexus/backend/.env
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
